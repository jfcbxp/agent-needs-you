{
  "name": "anu-kiro",
  "displayName": "Agent Needs You - Kiro",
  "description": "Reports Kiro Agent status to an Agent Needs You board.",
  "version": "0.1.0",
  "publisher": "local",
  "engines": { "vscode": "^1.100.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "Agent Needs You - Kiro",
      "properties": {
        "anuKiro.boardUrl": {
          "type": "string",
          "default": "http://192.168.68.232",
          "description": "Base URL of the Agent Needs You board."
        },
        "anuKiro.pollIntervalMs": {
          "type": "number",
          "default": 500,
          "minimum": 100,
          "maximum": 5000,
          "description": "Kiro session polling interval."
        }
      }
    },
    "commands": [
      { "command": "anuKiro.setWorking", "title": "Agent Needs You: Kiro Set Working" },
      { "command": "anuKiro.setNeedsYou", "title": "Agent Needs You: Kiro Set Needs You" },
      { "command": "anuKiro.setDone", "title": "Agent Needs You: Kiro Set Done" },
      { "command": "anuKiro.setIdle", "title": "Agent Needs You: Kiro Set Idle" },
      { "command": "anuKiro.testBoard", "title": "Agent Needs You: Kiro Test Board" }
    ]
  }
}
